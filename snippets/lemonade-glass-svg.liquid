{% doc %}
  Renders a decorative illustration of a standard lemonade glass: tall tumbler,
  lemonade fill, ice cubes, rising bubbles, a lemon wheel on the rim and a striped straw.
  Colors come from the caller's `--glass-tint` and `--glass-accent` custom properties.
  The SVG is decorative and hidden from assistive technology.

  @param {string} [class] - Extra classes for the root SVG.
  @param {string} id - Unique suffix for internal SVG IDs, e.g. the section ID.

  @example
  {% render 'lemonade-glass-svg', class: 'lemonade-hero__glass', id: section.id %}
{% enddoc %}

<svg
  class="lemonade-glass {{ class }}"
  viewBox="0 0 400 560"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id="lemonade-glass-clip-{{ id }}">
      <path d="M92 120 L308 120 L284 520 Q282 536 266 536 L134 536 Q118 536 116 520 Z" />
    </clipPath>
    <linearGradient
      id="lemonade-glass-liquid-{{ id }}"
      x1="0"
      y1="0"
      x2="0"
      y2="1"
    >
      <stop offset="0" style="stop-color: var(--glass-tint); stop-opacity: 0.85" />
      <stop offset="1" style="stop-color: var(--glass-tint)" />
    </linearGradient>
    <linearGradient
      id="lemonade-glass-shine-{{ id }}"
      x1="0"
      y1="0"
      x2="1"
      y2="0"
    >
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
  </defs>

  {%- comment -%} Straw (behind the glass rim) {%- endcomment -%}
  <g class="lemonade-glass__straw">
    <rect x="236" y="20" width="22" height="300" rx="6" transform="rotate(14 247 170)" fill="#fff" />
    <rect x="236" y="40" width="22" height="18" transform="rotate(14 247 170)" style="fill: var(--glass-accent)" />
    <rect x="236" y="80" width="22" height="18" transform="rotate(14 247 170)" style="fill: var(--glass-accent)" />
    <rect x="236" y="120" width="22" height="18" transform="rotate(14 247 170)" style="fill: var(--glass-accent)" />
    <rect x="236" y="160" width="22" height="18" transform="rotate(14 247 170)" style="fill: var(--glass-accent)" />
  </g>

  {%- comment -%} Glass contents {%- endcomment -%}
  <g clip-path="url(#lemonade-glass-clip-{{ id }})">
    <rect x="80" y="170" width="240" height="380" fill="url(#lemonade-glass-liquid-{{ id }})" />
    <path d="M80 170 Q140 160 200 170 T320 170 L320 182 Q260 192 200 182 T80 182 Z" fill="#fff" opacity="0.35" />

    <g class="lemonade-glass__ice" fill="#fff" fill-opacity="0.45" stroke="#fff" stroke-opacity="0.8" stroke-width="2">
      <rect x="120" y="188" width="62" height="58" rx="10" transform="rotate(-12 151 217)" />
      <rect x="196" y="202" width="58" height="56" rx="10" transform="rotate(16 225 230)" />
      <rect x="146" y="262" width="56" height="52" rx="10" transform="rotate(6 174 288)" />
    </g>

    <g class="lemonade-glass__bubbles" fill="#fff" fill-opacity="0.7">
      <circle cx="140" cy="480" r="5" />
      <circle cx="176" cy="500" r="3.5" />
      <circle cx="214" cy="470" r="4.5" />
      <circle cx="248" cy="505" r="3" />
      <circle cx="262" cy="450" r="4" />
      <circle cx="158" cy="420" r="3" />
      <circle cx="232" cy="400" r="3.5" />
    </g>
  </g>

  {%- comment -%} Glass outline and shine {%- endcomment -%}
  <path
    d="M92 120 L308 120 L284 520 Q282 536 266 536 L134 536 Q118 536 116 520 Z"
    fill="#fff"
    fill-opacity="0.12"
    stroke="#fff"
    stroke-opacity="0.9"
    stroke-width="5"
    stroke-linejoin="round"
  />
  <ellipse cx="200" cy="120" rx="108" ry="10" fill="none" stroke="#fff" stroke-opacity="0.9" stroke-width="5" />
  <path d="M112 150 L128 500 L146 500 L132 150 Z" fill="url(#lemonade-glass-shine-{{ id }})" />

  {%- comment -%} Lemon wheel on the rim {%- endcomment -%}
  <g class="lemonade-glass__lemon" transform="translate(110 118) rotate(-18)">
    <circle r="56" fill="#F4D03F" />
    <circle r="49" fill="#FBEFA5" />
    <g stroke="#F4D03F" stroke-width="3">
      <line x1="0" y1="-46" x2="0" y2="46" />
      <line x1="-46" y1="0" x2="46" y2="0" />
      <line x1="-32" y1="-32" x2="32" y2="32" />
      <line x1="-32" y1="32" x2="32" y2="-32" />
    </g>
    <circle r="6" fill="#F4D03F" />
  </g>
</svg>

{% stylesheet %}
  .lemonade-glass {
    display: block;
    block-size: 100%;
    inline-size: auto;
    max-inline-size: 100%;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 18%));
  }

  .lemonade-glass__bubbles circle {
    transform-box: fill-box;
    animation: lemonade-glass-rise 6s linear infinite;
  }

  .lemonade-glass__bubbles circle:nth-child(2n) {
    animation-duration: 8s;
    animation-delay: -2s;
  }

  .lemonade-glass__bubbles circle:nth-child(3n) {
    animation-duration: 7s;
    animation-delay: -4s;
  }

  @keyframes lemonade-glass-rise {
    from {
      transform: translateY(0);
      opacity: 0;
    }

    15% {
      opacity: 1;
    }

    to {
      transform: translateY(-300px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lemonade-glass__bubbles circle {
      animation: none;
    }
  }
{% endstylesheet %}
